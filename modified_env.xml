<mujoco>
    <include file="assets/scene.xml" />
    <include file="vx300s_dependencies.xml" />
    <include file="fanuc_inner/fanuc_dependencies.xml" />
    <include file="SL_Assets/Gripper_sl.xml" /> 
    
    <option timestep="0.001" />
    <option cone="elliptic" impratio="0.2" />
    

    <equality>
        
        
        <weld body1="table" body2="target_container" solref="0.02 1" solimp="0.9 0.95 0.001" />
        
    </equality>

    <worldbody>
        
        <include file="fanuc_inner/single_arm.xml" />
        <include file="vx300s_right.xml" />
        
        
        <body name="box" pos="0.25 0.9 0.5">
            <joint name="red_box_joint" type="free" frictionloss="0.1" />
            <inertial pos="0 0 0" mass="0.05" diaginertia="0.002 0.002 0.002" />
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="1.5 0.5 0.0001" pos="0 0 0" size="0.01 0.01 0.1" type="box" name="red_box" rgba="1 1 1 1" />
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="1.5 0.5 0.0001" pos="0 0 -0.1" size="0.06 0.06 0.02" type="box" name="box_base" rgba="1 1 1 1" />
        </body>
        <body name="banana" pos="0.1 0.8 0.3">
            <joint name="banana_joint" type="free" frictionloss="0.1" />
            <inertial pos="0 0 0" mass="0.05" diaginertia="0.002 0.002 0.002" />
            <geom mesh="banana" condim="4" solimp="2 1 0.01" solref="0.01 1" friction="1.5 0.5 0.0001" pos="0 0 0" size="1 1 1" type="mesh" name="banana_name" rgba="0.8 0.8 0 1" />
        </body>
        <body name="cup" pos="-0.5 0.9 0.2" quat="0 0.707 0 0.707">
            <joint name="cup_joint" type="free" frictionloss="0.05" />
            <inertial pos="0 0 0" mass="0.05" diaginertia="0.005 0.005 0.005" />
            <geom mesh="cup" condim="4" solimp="2 1 0.01" solref="0.01 1" friction="1.5 0.5 0.0001" pos="0 0 0" size="1 1 1" type="mesh" name="cup_name" rgba="0.9 0.9 0.9 1" />
        </body>
        <body name="teddy" pos="-0.6 0.9 0.2" quat="0.707 0.707 0 0">
            <joint name="teddy_joint" type="free" frictionloss="0.05" />
            <inertial pos="0 0 0" mass="0.05" diaginertia="0.005 0.005 0.005" />
            <geom mesh="teddy" condim="4" solimp="2 1 0.01" solref="0.01 1" friction="1.5 0.5 0.0001" pos="0 0 0" size="1 1 1" type="mesh" name="teddy_name" rgba="1 1 1 1" />
        </body>
        

        <body name="target_container" pos="0.7 0.5 0">
            
            <geom name="target_bottom" type="box" size="0.15 0.15 0.01" pos="0 0 0.01" />
            
            <geom name="target_left" type="box" size="0.01 0.15 0.15" pos="-0.15 0 0.06" />
            
            <geom name="target_right" type="box" size="0.01 0.15 0.15" pos="0.15 0 0.06" />
            
            <geom name="target_front" type="box" size="0.15 0.01 0.15" pos="0 -0.15 0.06" />
            
            <geom name="target_back" type="box" size="0.15 0.01 0.15" pos="0 0.15 0.06" />
        </body>
    </worldbody>

    <tendon>
        <spatial name="gripper_tendon" width="0.001" stiffness="2000" damping="10">
            <site site="dummy_site" />
            <site site="gripper_spring_site" />
        </spatial>
    </tendon>

    <asset>
        <material name="container_material" rgba="0.8 0.8 0.8 1" />
        <texture name="box_texture" type="2d" file="texture/box.png" />
        <material name="box_material" texture="box_texture" shininess="0.5" specular="0.3" />
        <texture name="wood_texture" type="2d" file="texture/Wood.png" />
        <material name="wood_material" texture="wood_texture" shininess="0.5" specular="0.3" />
        <texture name="cup_texture" type="2d" file="texture/cup.png" />
        <material name="cup_material" texture="cup_texture" shininess="0.5" specular="0.3" />
        <texture name="teddy_texture" type="2d" file="texture/teddy.png" />
        <material name="teddy_material" texture="teddy_texture" shininess="0.3" specular="0.3" />
    </asset>

    <actuator>
        <position ctrllimited="true" ctrlrange="-3.14158 3.14158" joint="joint_1" kp="1500" user="1" forcelimited="true" forcerange="-150 150" />
        <position ctrllimited="true" ctrlrange="-1.85005 1.25664" joint="joint_2" kp="900" user="1" forcelimited="true" forcerange="-300 300" />
        <position ctrllimited="true" ctrlrange="-1.76278 1.6057" joint="joint_3" kp="2000" user="1" forcelimited="true" forcerange="-200 200" />
        <position ctrllimited="true" ctrlrange="-3.14158 3.14158" joint="joint_4" kp="600" user="1" forcelimited="true" forcerange="-1000 1000" />
        <position ctrllimited="true" ctrlrange="-1.8675 2.23402" joint="joint_5" kp="700" user="1" forcelimited="true" forcerange="-180 180" />
        <position ctrllimited="true" ctrlrange="-3.14158 3.14158" joint="joint_6" kp="250" user="1" />
        <position ctrllimited="true" ctrlrange="0. 0.025" joint="gripper_left_finger" kp="700" user="1" />
        <position ctrllimited="true" ctrlrange="-0.025 0" joint="gripper_right_finger" kp="700" user="1" />
        

        <position ctrllimited="true" ctrlrange="-3.14158 3.14158" joint="vx300s_right/waist" kp="800" user="1" forcelimited="true" forcerange="-150 150" />
        <position ctrllimited="true" ctrlrange="-1.85005 1.25664" joint="vx300s_right/shoulder" kp="1600" user="1" forcelimited="true" forcerange="-300 300" />
        <position ctrllimited="true" ctrlrange="-1.76278 1.6057" joint="vx300s_right/elbow" kp="800" user="1" forcelimited="true" forcerange="-100 100" />
        <position ctrllimited="true" ctrlrange="-3.14158 3.14158" joint="vx300s_right/forearm_roll" kp="10" user="1" forcelimited="true" forcerange="-100 100" />
        <position ctrllimited="true" ctrlrange="-1.8675 2.23402" joint="vx300s_right/wrist_angle" kp="50" user="1" />
        <position ctrllimited="true" ctrlrange="-3.14158 3.14158" joint="vx300s_right/wrist_rotate" kp="20" user="1" />
        <position ctrllimited="true" ctrlrange="0.021 0.057" joint="vx300s_right/left_finger" kp="200" user="1" />
        <position ctrllimited="true" ctrlrange="-0.057 -0.021" joint="vx300s_right/right_finger" kp="200" user="1" />
    </actuator>

    <visual>
        <map znear="0.03" zfar="50" />
    </visual>



</mujoco>