<mujocoinclude>
<!--    <option timestep='0.0025' iterations="50" tolerance="1e-10" solver="Newton" jacobian="dense" cone="elliptic"/>-->
    <asset>
        <mesh file="tabletop.obj" name="tabletop" scale="0.002 0.002 0.002"/>
        <mesh file="banana.obj" name="banana" scale="0.001 0.001 0.001"/>
        <mesh file="cup.obj" name="cup" scale="0.001 0.001 0.001"/>
        <mesh file="teddy.obj" name="teddy" scale="0.3 0.3 0.3" />

    </asset>

    <visual>
        <map fogstart="1.5" fogend="5" force="0.1" znear="0.03"/>
        <quality shadowsize="4096" offsamples="4"/>
        <headlight ambient="0.6 0.6 0.6"/>
    </visual>

    <worldbody>



        <body name="midair" pos="0 .6 0.2">
            <site pos="0 0 0" size="0.01" type="sphere" name="midair" rgba="1 0 0 0"/>
        </body>

        <body name="walls">
            <!-- 左墙 -->
            <geom name="left_wall" type="box" pos="-2 0.6 0.9" size="0.05 1.7 3" rgba="0.5 0.5 0.5 1" 
            contype="0" conaffinity="0"/>

            <!-- 右墙 -->
            <geom name="right_wall" type="box" pos="2 0.6 0.9" size="0.05 1.7 3" rgba="0.5 0.5 0.5 1" 
            contype="0" conaffinity="0"/>

            <!-- 前墙 -->
            <geom name="front_wall" type="box" pos="0 2.3 0.9" size="2.2 0.05 3" rgba="0.5 0.5 0.5 1" 
            contype="0" conaffinity="0"/>

            <!-- 后墙 -->
            <geom name="back_wall" type="box" pos="0 -1.2 0.9" size="2.2 0.05 3" rgba="0.5 0.5 0.5 1" 
            contype="0" conaffinity="0"/>
        </body>

        <camera name="left_pillar" pos="-1 0.4 0.6" fovy="78" mode="targetbody" target="table"/>
        <camera name="right_pillar" pos="1 0.4 0.6" fovy="78" mode="targetbody" target="table"/>
        <camera name="top" pos="0 0.6 1.4" fovy="78" mode="targetbody" target="table"/>
        <camera name="angle" pos="0.5 0.6 0.8" fovy="78" mode="targetbody" target="table"/>
        <camera name="front_close" pos="0 1.6 0.7" fovy="78" mode="targetbody" target="table"/>
        

    </worldbody>



</mujocoinclude>